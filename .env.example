# Copy this file to .env for local development.
# On Render, set these as real Environment Variables in the dashboard instead
# (render.yaml already wires most of them up for you).

SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Leave unset locally to fall back to SQLite. On Render, this is populated
# automatically from the linked PostgreSQL database.
# DATABASE_URL=postgresql://user:password@host:5432/dbname
